{
  "manifest_version": 3,
  "name": "SSEO",
  "version": "0.1.0",
  "description": "Audit the SEO of the page you are on and keep a history of every page you checked, with PDF reports.",
  "icons": {
    "16": "icons/app-16.png",
    "32": "icons/app-32.png",
    "48": "icons/app-48.png",
    "128": "icons/app-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Audit this page",
    "default_icon": {
      "16": "icons/app-16.png",
      "32": "icons/app-32.png",
      "48": "icons/app-48.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "omnibox": {
    "keyword": "sseo"
  }
}
